---
import BaseLayout   from '../layouts/BaseLayout.astro';
import Section      from '../components/Section.astro';
import Button       from '../components/Button.astro';
import Logobar      from '../components/Logobar.astro';

const hersteller = [
  { name: 'Koppert Cress', url: 'https://www.koppertcress.com/de/', logo: 'koppert-cress.svg' },
  { name: 'Cresco', url: 'https://crescobv.com/', logo: null },
  { name: 'Van Vugt Kruiden', url: 'https://www.vanvugtkruiden.nl/?lang=de', logo: 'van-vugt-kruiden.png' },
  { name: 'Van der Plas', url: 'https://happysprouts.nl/de/', logo: 'van-der-plas.svg' },
  { name: 'Kikok', url: 'https://kikok.de/', logo: 'kikok.png' },
  { name: 'Geflügelhof Nobis', url: 'https://gefluegelhof-nobis.de/', logo: 'gefluegelhof-nobis.svg' },
  { name: 'Norderneyer Seeluftschinken', url: 'https://www.norderneyer-seeluftschinken.de/', logo: 'norderneyer-seeluftschinken.png' },
  { name: 'Tovano', url: 'https://www.tovano.nl/de/', logo: 'tovano.png' },
  { name: 'ELKA', url: 'https://www.elka-frische.de/', logo: 'elka-frische.png' },
  { name: 'Ponthier', url: 'https://www.ponthier.fr/en/', logo: 'ponthier.svg' },
  { name: 'Heinemann', url: 'https://www.heinemanngmbh.de/', logo: 'heinemann.svg' },
  { name: 'Bedford', url: 'https://www.bedford.de/', logo: 'bedford.svg' },
  { name: "Nature's Pride", url: 'https://www.naturespride.eu', logo: 'natures-pride.svg' },
];
---

<BaseLayout
  title="Sortiment und Leistungen | Lebensmittel-Großhandel Ostfriesland | Albert Wilts"
  description="Acht Warengruppen aus einer Hand: Obst und Gemüse, Kräuter und Kresse, Fleisch und Geflügel, Nüsse, Säfte und Küchenfertiges. Albert Wilts liefert an sechs Tagen in ganz Ostfriesland."
>

  <section class="sub-hero sub-hero--image" style="--hero-img: url('/bilder/unternehmen/eierkartons-braune-eier-ladenverkauf.webp')">
    <div class="sub-hero-inside">
      <h1>Frische Vielfalt und Service nach Maß</h1>
      <p class="sub-hero-sub">Vom Feld bis ins Kühlhaus: Entdecken Sie unser Frische-Sortiment für Profis und Genießer.</p>
      <div class="sub-hero-actions">
        <Button href="#kontakt" label="Sortimentsliste anfordern" />
        <span class="sub-hero-phone">oder anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
    </div>
  </section>

  <section class="sub-trustbar">
    <div class="sub-trustbar-inside">
      <span class="sub-trustbar-item">Seit 1958</span>
      <span class="sub-trustbar-item">Dritte Generation</span>
      <span class="sub-trustbar-item">Eigener Fuhrpark</span>
      <span class="sub-trustbar-item">Sechs Tage Lieferung</span>
      <span class="sub-trustbar-item">Bio-zertifiziert</span>
    </div>
  </section>

  <Section bg="#fff">
    <div class="sub-block">
      <h2>Alles aus einer Hand</h2>
      <p>Warum kompliziert, wenn es auch einfach geht? Als Ihr regionaler Partner bündeln wir die wichtigsten Frische-Sortimente in einer Lieferung. Egal ob Sie ein Restaurant, ein Hotel oder eine Großküche leiten, bei Albert Wilts erhalten Sie Qualität, auf die Sie sich verlassen können. Unsere Wurzeln liegen im Eierhandel von 1958, heute bieten wir Ihnen die komplette Bandbreite moderner Lebensmittelversorgung.</p>
    </div>
  </Section>

  <!-- Logo-Abbinder: Endlos-Lauf, Textbox wo kein Logo beschaffbar (Cresco) -->
  <Logobar title="Marken, die Ihre Küche kennt" items={hersteller} />

  <Section bg="#fff">
    <h2 class="sub-h2-center">Unsere Sortimente</h2>
    <p class="sub-lead-center">Acht Warengruppen, eine Lieferung. Fünf davon stellen wir Ihnen ausführlich vor.</p>
    <div class="sub-cards sub-cards--3">
      <div class="sub-card sub-catcard">
        <h3>Obst und Gemüse</h3>
        <p>Kartoffeln aus der Leybucht, Saisonware aus der Region und über 20 Tomatensorten. Dazu Exoten von Nature's Pride, auf Wunsch verzehrfertig.</p>
        <a class="sub-catcard-more" href="/sortiment-und-leistungen/obst-und-gemuese">Mehr erfahren <span class="arrow" aria-hidden="true">&#x203A;</span></a>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Kräuter, Kresse und Sprossen</h3>
        <p>Für die feine Küche und für den Gasthof: Wildkräuter, Kresse-Sorten, Blattsalatmischungen und Sprossen.</p>
        <a class="sub-catcard-more" href="/sortiment-und-leistungen/kraeuter-kresse-und-sprossen">Mehr erfahren <span class="arrow" aria-hidden="true">&#x203A;</span></a>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Fleisch, Wurst und Geflügel</h3>
        <p>Rind und Schwein, Kikok Maishähnchen, Ente und Gans, Wild aus heimischen Forsten und Norderneyer Seeluftschinken.</p>
        <a class="sub-catcard-more" href="/sortiment-und-leistungen/fleisch-wurst-und-gefluegel">Mehr erfahren <span class="arrow" aria-hidden="true">&#x203A;</span></a>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Nüsse und Trockenfrüchte</h3>
        <p>Nüsse, Kerne und getrocknete Früchte für Küche, Patisserie und Buffet.</p>
        <a class="sub-catcard-more" href="/sortiment-und-leistungen/nuesse-und-trockenfruechte">Mehr erfahren <span class="arrow" aria-hidden="true">&#x203A;</span></a>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Säfte und Fruchtpürees</h3>
        <p>Frisch gepresste Säfte im Gastro-Gebinde und über 55 Fruchtpürees für Patisserie und Bar.</p>
        <a class="sub-catcard-more" href="/sortiment-und-leistungen/saefte-und-fruchtpuerees">Mehr erfahren <span class="arrow" aria-hidden="true">&#x203A;</span></a>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Eier</h3>
        <p>Hier liegen unsere Wurzeln. Frische Eier aus der Region, als Stangenware oder im Karton, in bedarfsgerechten Gebinden.</p>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Kartoffeln und Ready Cut</h3>
        <p>Kartoffeln aus der Leybucht, dazu geschälte Ware und küchenfertige Schnittware in Großgebinden von unserem Partner Heinemann.</p>
      </div>
      <div class="sub-card sub-catcard">
        <h3>Küchenfertig vorbereitet</h3>
        <p>Feinkost, Schnittware und marinierte Pfannengerichte, die Ihrem Team Arbeit abnehmen.</p>
        <a class="sub-catcard-more" href="#kuechenfertig">Mehr erfahren <span class="arrow" aria-hidden="true">&#x203A;</span></a>
      </div>
    </div>
  </Section>

  <Section bg="#fff" id="kuechenfertig">
    <h2>Küchenfertig vorbereitet</h2>
    <p class="sub-lead">Wir unterstützen Ihre Küche mit vorbereiteten Produkten, die Ihnen Arbeitszeit sparen, ohne dass die Qualität leidet.</p>
    <div class="sub-cards">
      <div class="sub-card">
        <h3>Feinkost und Schnittware</h3>
        <p>Salate, Dips sowie küchenfertig geschnittenes Obst und Gemüse von unserem Partner Heinemann aus Wiefelstede. Frisch angeliefert und sofort einsatzbereit.</p>
        <p class="sub-brandlinks"><a class="sub-brandlink" href="https://www.heinemanngmbh.de/" target="_blank" rel="noopener noreferrer">Zur Website von Heinemann</a></p>
      </div>
      <div class="sub-card">
        <h3>Essfertige Geflügelspezialitäten</h3>
        <p>Premium-Convenience von Bedford aus Osnabrück, einer Wurst- und Schinkenmanufaktur mit eigener Geflügellinie. Fertig gegarte und frittierte Hähnchenbrustschnitten, die in Ihrer Küche nur noch angerichtet werden.</p>
        <p class="sub-brandlinks"><a class="sub-brandlink" href="https://www.bedford.de/" target="_blank" rel="noopener noreferrer">Zur Website von Bedford</a></p>
      </div>
      <div class="sub-card">
        <h3>Aus eigener Vorbereitung</h3>
        <p>Unsere Pfannengerichte entstehen im Haus: frische Hähnchenbrust, in Streifen geschnitten und mit Marinade und Gemüseeinlage veredelt, etwa als Curry-, Bali- oder Kürbispfanne. Diese Ware erhitzen Sie in Ihrer Küche durch. Keine Industrieware, sondern Handarbeit aus unserem Haus.</p>
      </div>
    </div>
  </Section>

  <section class="sub-midcta">
    <div class="sub-midcta-inside">
      <p class="sub-midcta-text"><strong>Fragen zum Sortiment?</strong> Wir stellen Ihre Lieferung passend zusammen.</p>
      <div class="sub-midcta-actions">
        <Button href="#kontakt" label="Sortimentsliste anfordern" />
        <a href="tel:+49493491060" class="sub-phone sub-midcta-phone">04934 91060</a>
      </div>
    </div>
  </section>

  <Section bg="#F8F8F8">
    <h2>Mehr als nur Ware</h2>
    <p class="sub-lead">Ein gutes Produkt ist wertlos, wenn es nicht pünktlich bei Ihnen ist. Darum ist unsere Dienstleistung genauso wichtig wie unser Sortiment.</p>
    <div class="sub-featcols">
      <div class="sub-featcol sub-featcol-top">
        <h3>Flexible Logistik</h3>
        <p>Unser eigener Fuhrpark mit fünf Lkw ist an sechs Tagen die Woche in ganz Ostfriesland unterwegs, pünktlich bis in Ihr Lager oder Kühlhaus.</p>
      </div>
      <div class="sub-featcol sub-featcol-top">
        <h3>Insel-Versorgung</h3>
        <p>Wir beliefern Norderney und die ostfriesischen Inseln mehrmals wöchentlich. Wir kennen die Fährpläne und sorgen dafür, dass die Ware sicher ankommt.</p>
      </div>
      <div class="sub-featcol sub-featcol-top">
        <h3>Persönlicher Ansprechpartner</h3>
        <p>Keine Callcenter, keine Warteschleifen. Bei uns sprechen Sie mit Menschen, die Ihr Geschäft verstehen und sich persönlich kümmern.</p>
      </div>
    </div>
  </Section>

  <section class="sub-cta section-pad" id="kontakt">
    <div class="sub-cta-inside">
      <h2>Überzeugen Sie sich selbst</h2>
      <p>Sie suchen einen Lieferanten, der Sortimentsbreite mit persönlicher Nähe verbindet? Sprechen Sie uns an.</p>
      <div class="sub-cta-actions">
        <Button href="mailto:info@albert-wilts.de" label="Jetzt Kunde werden" />
        <span class="sub-cta-phone">oder anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
    </div>
  </section>

</BaseLayout>

---
import BaseLayout          from '../layouts/BaseLayout.astro';
import HeroBuehne          from '../components/HeroBuehne.astro';
import HeroSection         from '../components/HeroSection.astro';
import InfoLeiste          from '../components/InfoLeiste.astro';
import BereicheSection     from '../components/BereicheSection.astro';
import SortimentSection    from '../components/SortimentSection.astro';
import GeschichteSection   from '../components/GeschichteSection.astro';
import NewsletterSection   from '../components/NewsletterSection.astro';
import Section             from '../components/Section.astro';
import Button              from '../components/Button.astro';
import { pressebeitraege } from '../data/presse.js';
import PresseCard from '../components/PresseCard.astro';
import Rezensionen from '../components/Rezensionen.astro';

// Drei neueste frei lesbare Beitraege
const presseTeaser = [...pressebeitraege]
  .filter((p) => p.zugang === 'frei')
  .sort((a, b) => (a.datum < b.datum ? 1 : -1))
  .slice(0, 3);
---

<BaseLayout
  title="Albert Wilts, Frische aus Tradition"
  description="Albert Wilts e.K., Lebensmittel-Großhandel seit 1958 in Upgant-Schott. Frische für Gastronomie, Hotellerie und Familientisch."
>
  <!-- Sektion 1 und 2: Hero und Info-Leiste auf gemeinsamer Video-Bühne -->
  <HeroBuehne>
    <HeroSection />
    <InfoLeiste />
  </HeroBuehne>

  <!-- Sektion 2b: Google-Bewertungen (kuratiert, Slider, Unterseite /bewertungen) -->
  <Section bg="#F8F8F8">
    <Rezensionen profil="wilts" headline="Das sagen Kundinnen und Kunden über Albert Wilts" mehr={{ href: '/bewertungen', label: 'Alle Bewertungen ansehen' }} />
  </Section>

  <!-- Sektion 3: Bereiche – Gewerbe & Privat (article-56) -->
  <BereicheSection />

  <!-- Sektion 4: Frische-Sortiment (article-57) -->
  <SortimentSection />

  <!-- Sektion 5: Unsere Geschichte (Teaser) -->
  <GeschichteSection />

  <!-- Sektion 6: Bekannt aus Funk und Fernsehen (Presse) -->
  <Section bg="#F8F8F8">
    <div style="text-align:center;">
      <h2>Bekannt aus Funk und Fernsehen</h2>
      <p class="sub-lead-center">Als ostfriesisches Original werden wir gerne gesehen und gelesen. Ein Einblick in unsere Pressestimmen.</p>
      <div class="presse-grid" style="margin-top:40px; text-align:left;">
        {presseTeaser.map((p) => <PresseCard eintrag={p} />)}
      </div>
      <div style="margin-top:40px;">
        <Button href="/presse" label="Alle Pressestimmen" />
      </div>
    </div>
  </Section>

  <!-- Sektion 7: Newsletter -->
  <NewsletterSection />
</BaseLayout>

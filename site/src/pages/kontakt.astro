---
import BaseLayout   from '../layouts/BaseLayout.astro';
import Section      from '../components/Section.astro';
import Button       from '../components/Button.astro';
---

<BaseLayout
  title="Kontakt | Albert Wilts e.K. in Upgant-Schott"
  description="So erreichen Sie Albert Wilts: Telefon, E-Mail, Kontaktformular und Anfahrt zu unserem Stammsitz in Upgant-Schott. Wir sind persönlich für Sie da."
>

  <section class="sub-hero">
    <div class="sub-hero-inside">
      <h1>So erreichen Sie uns</h1>
      <p class="sub-hero-sub">Am liebsten persönlich. Rufen Sie uns an, schreiben Sie uns oder kommen Sie vorbei, bei Albert Wilts sprechen Sie immer mit echten Menschen.</p>
      <div class="sub-hero-actions">
        <span class="sub-hero-phone">Direkt anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
    </div>
  </section>

  <Section bg="#fff" id="formular">
    <div class="sub-contact-grid">
      <div class="sub-contact-methods">
        <div class="sub-contact-method sub-contact-phone">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.57 4.9 2 2 0 0 1 3.55 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <div>
            <div class="sub-contact-method-label">Telefon</div>
            <div class="sub-contact-method-val"><a href="tel:+49493491060">04934 91060</a></div>
            <p class="sub-contact-sub">Wir sind persönlich für Sie da. Fax: 04934 910629</p>
          </div>
        </div>
        <div class="sub-contact-method">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <div>
            <div class="sub-contact-method-label">E-Mail</div>
            <div class="sub-contact-method-val"><a href="mailto:info@albert-wilts.de">info@albert-wilts.de</a></div>
          </div>
        </div>
        <div class="sub-contact-method">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <div class="sub-contact-method-label">Adresse</div>
            <div class="sub-contact-method-val">Albert Wilts e.K.<br>Hansestr. 4<br>26529 Upgant-Schott</div>
            <p class="sub-contact-sub">Hofladen: freitags 8 bis 18 Uhr</p>
          </div>
        </div>

        <div class="sub-contact-map">
          <div class="sub-standort-map" id="kontakt-map"></div>
          <p class="sub-standort-maplink"><a href="https://www.google.com/maps/search/?api=1&query=Albert+Wilts+Hansestra%C3%9Fe+4+Upgant-Schott" target="_blank" rel="noopener">Route planen ›</a></p>
        </div>
      </div>

      <form class="sub-form" action="https://FORMULAR-ENDPUNKT-EINTRAGEN" method="POST">
        <input type="text" name="_gotcha" class="sub-form-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="sub-form-row">
          <div class="sub-field">
            <label for="k-name">Name *</label>
            <input id="k-name" name="name" type="text" required>
          </div>
          <div class="sub-field">
            <label for="k-firma">Firma</label>
            <input id="k-firma" name="firma" type="text">
          </div>
        </div>
        <div class="sub-form-row">
          <div class="sub-field">
            <label for="k-email">E-Mail *</label>
            <input id="k-email" name="email" type="email" required>
          </div>
          <div class="sub-field">
            <label for="k-tel">Telefon</label>
            <input id="k-tel" name="telefon" type="tel">
          </div>
        </div>
        <div class="sub-field">
          <label for="k-anliegen">Ihr Anliegen</label>
          <select id="k-anliegen" name="anliegen">
            <option>Anfrage Gastronomie oder Hotellerie</option>
            <option>Anfrage Großverbraucher oder Pflege</option>
            <option>Privat, Markt und Laden</option>
            <option>Sonstiges</option>
          </select>
        </div>
        <div class="sub-field">
          <label for="k-nachricht">Ihre Nachricht *</label>
          <textarea id="k-nachricht" name="nachricht" required></textarea>
        </div>
        <label class="sub-form-consent">
          <input type="checkbox" name="datenschutz" required>
          <span>Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage einverstanden.</span>
        </label>
        <button type="submit" class="sub-form-submit">Nachricht senden</button>
      </form>
    </div>

    <script>
      (function () {
        const box = document.getElementById('kontakt-map');
        if (!box) return;
        const QUERY = 'Albert Wilts Hansestraße 4 Upgant-Schott';
        const render = () => {
          const ok = window.awConsent && window.awConsent.get('maps');
          if (ok) {
            box.innerHTML = '';
            const ifr = document.createElement('iframe');
            ifr.src = 'https://maps.google.com/maps?q=' + encodeURIComponent(QUERY) + '&z=15&output=embed';
            ifr.loading = 'lazy';
            ifr.title = 'Karte: Albert Wilts Upgant-Schott';
            ifr.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
            box.appendChild(ifr);
          } else {
            box.innerHTML = '<div class="sub-map-fallback"><p>Aufgrund Ihrer Cookie-Einstellung kann die Karte nicht geladen werden. Stimmen Sie der Kategorie Karten zu, um den Standort hier anzuzeigen.</p><button type="button" data-aw-consent-open>Cookie-Einstellungen anpassen</button></div>';
          }
        };
        document.addEventListener('aw:consent-change', render);
        render();
      })();
    </script>
  </Section>

  <Section bg="#F8F8F8">
    <h2 class="sub-h2-center">Ihre Ansprechpartner</h2>
    <p class="sub-lead-center">Drei Generationen, ein Team. Bei uns wissen Sie immer, mit wem Sie sprechen.</p>
    <div class="sub-people">
      <div class="sub-person">
        <div class="sub-portrait sub-portrait--square"><img src="/bilder/unternehmen/team/andree-wilts.webp" alt="Andree Wilts, Geschäftsführung, Einkauf und Auslieferung" width="1200" height="1500" loading="lazy" decoding="async" /></div>
        <h3>Andree Wilts</h3>
        <p>Geschäftsführung, Einkauf und Auslieferung</p>
      </div>
      <div class="sub-person">
        <div class="sub-portrait sub-portrait--square"><img src="/bilder/unternehmen/team/anke-wilts.webp" alt="Anke Wilts, Verkauf und Wochenmärkte" width="1200" height="1500" loading="lazy" decoding="async" /></div>
        <h3>Anke Wilts</h3>
        <p>Verkauf und Wochenmärkte</p>
      </div>
      <div class="sub-person">
        <div class="sub-portrait sub-portrait--square"><img src="/bilder/unternehmen/team/anita-wilts.webp" alt="Anita Wilts, Büro und Ladenverkauf" width="1200" height="1500" loading="lazy" decoding="async" /></div>
        <h3>Anita Wilts</h3>
        <p>Büro und Ladenverkauf</p>
      </div>
    </div>
  </Section>

  <section class="sub-cta section-pad" id="kontakt">
    <div class="sub-cta-inside">
      <h2>Wir freuen uns auf Ihre Nachricht</h2>
      <p>Ob Anfrage, Angebot oder einfach ein Schnack, melden Sie sich gern bei uns.</p>
      <div class="sub-cta-actions">
        <Button href="#formular" label="Nachricht schreiben" />
        <span class="sub-cta-phone">oder anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
    </div>
  </section>

</BaseLayout>

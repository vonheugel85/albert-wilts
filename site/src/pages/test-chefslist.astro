---
/*
  test-chefslist.astro: interne Testseite zur Abnahme des Chefslist-Blocks (K5b, 2026-10-16).
  Nicht verlinkt, nicht in der Navigation, trägt noindex. Nach Abnahme wandert ChefslistZugang
  auf die vier Gewerbeseiten; diese Seite kann dann entfallen.
*/
import BaseLayout  from '../layouts/BaseLayout.astro';
import ChefslistZugang from '../components/ChefslistZugang.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Testseite Chefslist | nicht veröffentlichen" noindex={true}>
  <div class="cl-testhinweis">Interne Testseite. Dieser Stand ist nicht freigegeben und nicht verlinkt.</div>
  <ChefslistZugang flaeche="hell" karte="weiss" />
  <section class="sub-cta sub-cta--weiss section-pad">
    <div class="sub-cta-inside">
      <h2>Werden Sie Partner</h2>
      <p>Profitieren Sie von kurzen Entscheidungswegen und einem Lebensmittel-Großhandel für Gewerbekunden, bei dem Sie keine Nummer sind, sondern ein Partner.</p>
      <div class="sub-cta-actions">
        <Button href="mailto:info@albert-wilts.de" label="Preisliste anfordern" />
        <span class="sub-cta-phone">oder anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cl-testhinweis {
    background: #3B3C42;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 24px;
    text-align: center;
    padding: 8px 20px;
  }
</style>

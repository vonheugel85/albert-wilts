---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section    from '../components/Section.astro';
import Button     from '../components/Button.astro';
import PresseCard from '../components/PresseCard.astro';
import { pressebeitraege, kategorien } from '../data/presse.js';

const sortiert = [...pressebeitraege].sort((a, b) => (a.datum < b.datum ? 1 : -1));

// Kennzahlen aus den Daten
const anzahl     = sortiert.length;
const anzahlTv   = sortiert.filter((p) => p.kategorie === 'tv').length;
const redaktionen = [...new Set(sortiert.map((p) => p.medium))];
const seitJahr   = Math.min(...sortiert.map((p) => Number(p.datum.slice(0, 4))));
const zahlen = [
  { wert: anzahl,             label: 'Beiträge' },
  { wert: anzahlTv,           label: 'TV-Porträts' },
  { wert: redaktionen.length, label: 'Redaktionen' },
  { wert: `seit ${seitJahr}`, label: 'in den Medien' },
];
---

<BaseLayout
  title="Presse | Bekannt aus Funk und Fernsehen | Albert Wilts"
  description="Albert Wilts in den Medien: Berichte aus Zeitung, Funk und Fernsehen über unseren ostfriesischen Familienbetrieb. Hier finden Sie unsere Pressestimmen."
>

  <section class="sub-hero">
    <div class="sub-hero-inside">
      <h1>Bekannt aus Funk und Fernsehen</h1>
      <p class="sub-hero-sub">Als ostfriesisches Original werden wir gerne gesehen und gelesen. Hier finden Sie eine Auswahl unserer Pressestimmen.</p>
      <dl class="presse-zahlen">
        {zahlen.map((z) => (
          <div class="presse-zahl">
            <dt>{z.label}</dt>
            <dd>{z.wert}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Section bg="#F8F8F8">
    <div class="presse-grid">
      {sortiert.map((p) => <PresseCard eintrag={p} />)}
    </div>
  </Section>

  <section class="sub-cta section-pad" id="kontakt">
    <div class="sub-cta-inside">
      <h2>Sie möchten über uns berichten?</h2>
      <p>Für Presseanfragen, Bildmaterial oder einen Termin vor Ort erreichen Sie uns direkt.</p>
      <div class="sub-cta-actions">
        <Button href="mailto:info@albert-wilts.de" label="Presseanfrage senden" />
        <span class="sub-cta-phone">oder anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
    </div>
  </section>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section    from '../components/Section.astro';
import Button     from '../components/Button.astro';
import PresseCard from '../components/PresseCard.astro';
import { pressebeitraege, kategorien, zugangLabel, medienReihenfolge } from '../data/presse.js';

const sortiert = [...pressebeitraege].sort((a, b) => (a.datum < b.datum ? 1 : -1));
const tvBeitraege = sortiert.filter((p) => p.kategorie === 'tv');

// Kennzahlen aus den Daten
const anzahl     = sortiert.length;
const anzahlTv   = sortiert.filter((p) => p.kategorie === 'tv').length;
const redaktionen = [...new Set(sortiert.map((p) => p.medium))];
// Leiste in fester Reihenfolge; Medien ohne Eintrag in medienReihenfolge haengen hinten an
const medienLeiste = [
  ...medienReihenfolge.filter((m) => redaktionen.includes(m)),
  ...redaktionen.filter((m) => !medienReihenfolge.includes(m)),
];
const seitJahr   = Math.min(...sortiert.map((p) => Number(p.datum.slice(0, 4))));
const zahlen = [
  { wert: anzahl,             label: 'Beiträge' },
  { wert: anzahlTv,           label: 'TV-Porträts' },
  { wert: redaktionen.length, label: 'Redaktionen' },
  { wert: `seit ${seitJahr}`, label: 'in den Medien' },
];

// Filter-Tabs: Anzahl je Kategorie
const tabs = Object.entries(kategorien).map(([key, k]) => ({
  key,
  label: k.label,
  hinweis: k.hinweis,
  count: key === 'alle' ? anzahl : sortiert.filter((p) => p.kategorie === key).length,
}));
---

<BaseLayout
  title="Presse | Bekannt aus Funk und Fernsehen | Albert Wilts"
  description="Albert Wilts in den Medien: Berichte aus Zeitung, Funk und Fernsehen über unseren ostfriesischen Familienbetrieb. Hier finden Sie unsere Pressestimmen."
>

  <section class="sub-hero">
    <div class="sub-hero-inside">
      <h1>Bekannt aus Funk und Fernsehen</h1>
      <p class="sub-hero-sub">Als ostfriesisches Original werden wir gerne gesehen und gelesen. Hier finden Sie eine Auswahl unserer Pressestimmen.</p>
      <dl class="presse-zahlen">
        {zahlen.map((z) => (
          <div class="presse-zahl">
            <dt>{z.label}</dt>
            <dd>{z.wert}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Section bg="#fff">
    <div class="presse-tv">
      {tvBeitraege.map((p) => (
        <article class="presse-tv-card">
          <span class="presse-tv-badge">{p.format}</span>
          <p class="presse-tv-medium">{p.medium}{p.reihe ? `, ${p.reihe}` : ''} · {p.datumLabel}</p>
          <h2 class="presse-tv-titel">{p.titel}</h2>
          <p class="presse-tv-teaser">{p.teaser}</p>
          <footer class="presse-tv-foot">
            {p.url ? (
              <a class="presse-tv-link" href={p.url} target="_blank" rel="noopener">
                <span>Zum Beitrag</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="öffnet in neuem Tab" role="img"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            ) : (
              <span class="presse-tv-offline">Derzeit nicht online</span>
            )}
            <span class={`presse-tv-zugang presse-tv-zugang--${p.zugang}`}>{zugangLabel[p.zugang]}</span>
          </footer>
        </article>
      ))}
    </div>
  </Section>

  <Section bg="#fff">
    <p class="sub-lead-center presse-medien-lead">Gesehen und gelesen bei</p>
    <ul class="presse-medien">
      {medienLeiste.map((m) => <li>{m}</li>)}
    </ul>
  </Section>

  <Section bg="#F8F8F8" id="presse">
    <div class="presse-filter" role="tablist" aria-label="Pressebeiträge filtern">
      {tabs.map((t, i) => (
        <button
          type="button"
          class="presse-tab"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-filter={t.key}
          data-hinweis={t.hinweis}
        >
          {t.label} <span class="presse-tab-count">{t.count}</span>
        </button>
      ))}
    </div>
    <p class="presse-hinweis" id="presse-hinweis">{tabs[0].hinweis}</p>

    <div class="presse-grid" id="presse-grid">
      {sortiert.map((p) => <PresseCard eintrag={p} />)}
    </div>
  </Section>

  <section class="sub-cta section-pad" id="kontakt">
    <div class="sub-cta-inside">
      <h2>Sie möchten über uns berichten?</h2>
      <p>Für Presseanfragen, Bildmaterial oder einen Termin vor Ort erreichen Sie uns direkt.</p>
      <div class="sub-cta-actions">
        <Button href="mailto:info@albert-wilts.de" label="Presseanfrage senden" />
        <span class="sub-cta-phone">oder anrufen: <a href="tel:+49493491060" class="sub-phone">04934 91060</a></span>
      </div>
      <p class="presse-cta-mappe">
        <Button href="/kontakt" label="Pressemappe anfragen" variant="link" />
      </p>
    </div>
  </section>

</BaseLayout>

<script>
  const root = document.getElementById('presse');
  if (root) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.presse-tab');
    const cards = root.querySelectorAll<HTMLElement>('#presse-grid .pc');
    const hinweis = document.getElementById('presse-hinweis');
    const FADE = 200;

    const apply = (filter: string) => {
      cards.forEach((c) => {
        const show = filter === 'alle' || c.dataset.kategorie === filter;
        const hidden = c.classList.contains('is-hidden');
        if (show && hidden) {
          c.classList.remove('is-hidden');
          c.classList.add('is-hiding');
          requestAnimationFrame(() => requestAnimationFrame(() => c.classList.remove('is-hiding')));
        } else if (!show && !hidden) {
          c.classList.add('is-hiding');
          setTimeout(() => { if (c.classList.contains('is-hiding')) c.classList.add('is-hidden'); }, FADE);
        }
      });
    };

    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      if (hinweis) hinweis.textContent = t.dataset.hinweis ?? '';
      apply(t.dataset.filter ?? 'alle');
    }));
  }
</script>

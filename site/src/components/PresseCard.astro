---
/*
  PresseCard.astro – einheitliche Presse-Karte (P5).
  Props: eintrag (aus data/presse.js). Kein Bild, kein Platzhalter.
*/
import { zugangLabel } from '../data/presse.js';

interface Props {
  eintrag: {
    id: string; kategorie: string; medium: string; reihe?: string;
    datum: string; datumLabel: string; titel: string; teaser: string;
    url: string | null; zugang: 'frei' | 'paywall' | 'offline'; format: string;
  };
}
const { eintrag: e } = Astro.props;
const jahr = e.datum.slice(0, 4);
// Offline-Beitraege mit URL verlinken auf Sendungsinfo, nicht auf den Beitrag selbst
const linkText = e.zugang === 'offline' ? 'Zur Sendungsinfo' : 'Zum Beitrag';
---

<article class="pc" data-kategorie={e.kategorie} data-datum={e.datum}>
  <header class="pc-head">
    <span class="pc-format">{e.format}</span>
    <span class="pc-jahr">{jahr}</span>
  </header>
  <p class="pc-medium">{e.medium}{e.reihe ? `, ${e.reihe}` : ''}</p>
  <h3 class="pc-titel">{e.titel}</h3>
  <p class="pc-teaser">{e.teaser}</p>
  <footer class="pc-foot">
    {e.url ? (
      <a class="pc-link" href={e.url} target="_blank" rel="noopener">
        <span>{linkText}</span>
        <svg class="pc-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="öffnet in neuem Tab" role="img">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    ) : (
      <span class="pc-offline">Derzeit nicht online</span>
    )}
    <span class={`pc-zugang pc-zugang--${e.zugang}`}>{zugangLabel[e.zugang]}</span>
  </footer>
</article>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #F9FAFB;
    border: 1px solid #F3F4F6;
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    padding: 24px;
    opacity: 1;
    transform: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .pc.is-hiding { opacity: 0; transform: scale(0.98); }
  .pc.is-hidden { display: none; }

  .pc-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .pc-format {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: #4F7146;
    padding: 4px 9px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .pc-jahr { font-family: var(--font-display); font-size: 20px; color: #7F7F7F; line-height: 1; }

  .pc-medium { font-family: var(--font-sans); font-size: 14px; line-height: 1.4; color: #7F7F7F; margin: 0 0 6px; }
  .pc-titel {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
    color: #3B3C42;
    margin: 0 0 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-teaser {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: #555;
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 14px; border-top: 1px solid #EDEDED; }
  .pc-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    color: #EF7F1A;
    text-decoration: none;
    white-space: nowrap;
  }
  .pc-link:hover span { text-decoration: underline; }
  .pc-ext { width: 14px; height: 14px; flex-shrink: 0; }
  .pc-offline { font-family: var(--font-sans); font-size: 14px; font-style: italic; color: #999; }

  .pc-zugang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: #7F7F7F;
    white-space: nowrap;
  }
  .pc-zugang::before { content: ''; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .pc-zugang--frei::before    { background: #4F7146; }
  .pc-zugang--paywall::before { background: #EF7F1A; }
  .pc-zugang--offline::before { background: #B0AFA9; }
</style>

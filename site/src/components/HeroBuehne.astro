---
/*
  HeroBuehne.astro: gemeinsame Bühne für Hero und Info-Leiste der Startseite (V1, 2026-10-22).
  Hintergrund: Foto (Poster und Fallback) plus stummes Schleifenvideo ab 769 px, darüber Markengrün
  im unteren Zehntel deckend, nach oben linear transparenter bis 85 % an der Oberkante; Hero und Leiste liegen beide darauf. Die
  Kinder (HeroSection, InfoLeiste) sind transparent und liegen auf dem Video.
  Quelle: Drohnenflug 10/2026, 20,5 s nahtlos, 720p, stark komprimiert (die Abdunklung schluckt Details).
  Mobil laeuft das Video nur hinter dem Hero, die Leiste darunter ist deckend gruen (seit 23.10.2026). Reduzierte Bewegung: nur Foto.
*/
---

<div class="hero-buehne">
  <img
    src="/bilder/unternehmen/albert-wilts-gebaeudeaussen-hero.webp"
    alt=""
    aria-hidden="true"
    class="hero-buehne-bild"
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />
  <video
    class="hero-buehne-video"
    autoplay muted loop playsinline
    preload="metadata"
    poster="/video/gelaende-hero-poster.webp"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/video/gelaende-hero.mp4" type="video/mp4" />
  </video>
  <div class="hero-buehne-scrim" aria-hidden="true"></div>
  <div class="hero-buehne-inhalt">
    <slot />
  </div>
</div>

<script>
  /* Mobil: Hintergrundhoehe der Buehne auf die Hero-Hoehe begrenzen (CSS allein kennt die Kinderhoehe nicht). */
  for (const b of document.querySelectorAll('.hero-buehne')) {
    const hero = b.querySelector('.hero-section');
    if (!hero) continue;
    const setzen = () => b.style.setProperty('--buehne-hero-hoehe', `${hero.getBoundingClientRect().height}px`);
    setzen();
    new ResizeObserver(setzen).observe(hero);
  }
</script>

<style>
  .hero-buehne { position: relative; width: 100%; overflow: hidden; background: #4F7146; }
  .hero-buehne-bild,
  .hero-buehne-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    z-index: 0;
  }
  .hero-buehne-bild { object-position: 50% 55%; }
  /* Markengrün über der gesamten Bühne: unteres Zehntel deckend, nach oben linear transparenter bis 85 % an der Oberkante (Wert von Manuel, 22.10.2026) */
  .hero-buehne-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #4F7146 10%, rgba(79, 113, 70, 0.85) 100%);
    z-index: 1;
  }
  .hero-buehne-inhalt { position: relative; z-index: 2; }

  @media (prefers-reduced-motion: reduce) {
    .hero-buehne-video { display: none; }
  }
  /* Mobil: Buehne nur hinter dem Hero (Hintergrund auf dessen Hoehe begrenzt), die Info-Leiste darunter
     bekommt ihr eigenes deckendes Gruen; sonst wuerde das Video auf 1500px Hoehe gezogen und zeigt nur einen Streifen. */
  @media (max-width: 768px) {
    .hero-buehne-bild,
    .hero-buehne-video,
    .hero-buehne-scrim { height: var(--buehne-hero-hoehe, 100%); }
    .hero-buehne-inhalt > :global(.info-leiste) { background: #4F7146; }
  }
</style>

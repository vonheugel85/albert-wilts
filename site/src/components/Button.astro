---
/*
  Button.astro – Zwei-Stile-System (B1) plus Hero-Ausnahme.

  Props:
    href      – Ziel-URL (required)
    variant   – "primary" (orange gefuellt, Pfeil vorne, default)
                "link"    (Textlink orange, Pfeil hinten, kein Hintergrund)
                "outline" (weisser Rahmen, nur auf dunklen Hero-Bildern)
    label     – Linktext; alternativ Slot
    class     – zusaetzliche Klassen (z. B. btn-link--white in InfoLeiste)
*/

interface Props {
  href:      string;
  variant?:  'primary' | 'link' | 'outline';
  label?:    string;
  class?:    string;
}

const { href, variant = 'primary', label, class: extra } = Astro.props;
---

{variant === 'link' ? (
  <a href={href} class:list={['btn-link', extra]}>
    <span class="btn-link-label">{label ?? <slot />}</span>
    <span class="btn-link-arrow" aria-hidden="true">&#x203A;</span>
  </a>
) : (
  <a href={href} class:list={['btn-primary', variant === 'outline' && 'btn-primary--outline', extra]}>
    <span class="btn-primary-inner">
      <span class="btn-primary-chevron" aria-hidden="true">&#x203A;</span>
      <span class="btn-primary-label">{label ?? <slot />}</span>
    </span>
  </a>
)}

<style>
  /* ── btn-primary: orange gefuellt ── */
  .btn-primary {
    display: inline-block;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.5;
    color: #fff;
    background: #EF7F1A;
    padding: 12px 20px;
    border-radius: 6px;
    transition: background 0.18s ease-out;
  }
  .btn-primary:hover { background: #d9700f; }

  .btn-primary-inner { display: inline-flex; align-items: center; }
  .btn-primary-chevron { margin-right: 6px; line-height: 1; display: flex; align-items: center; }
  .btn-primary-label { display: inline-block; transition: transform 0.2s ease-out; }
  .btn-primary:hover .btn-primary-label { transform: translateX(4px); }

  /* ── outline: nur auf dunklen Hero-Bildern ── */
  .btn-primary--outline {
    background: transparent;
    border: 2px solid #fff;
    padding: 10px 18px;
  }
  .btn-primary--outline:hover { background: rgba(255, 255, 255, 0.1); }

  /* ── btn-link: Textlink orange, Pfeil hinten ── */
  .btn-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5;
    color: #EF7F1A;
  }
  .btn-link:hover .btn-link-label { text-decoration: underline; }
  .btn-link-arrow { display: inline-block; font-weight: 400; transition: transform 0.18s ease; }
  .btn-link:hover .btn-link-arrow { transform: translateX(4px); }

  /* Weiss-Variante auf gruenen Flaechen */
  .btn-link--white { color: #fff; }
</style>

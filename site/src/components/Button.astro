---
/*
  Button.astro – einheitliche Button-Primitive für alle Sektionen.

  Props:
    href      – Ziel-URL (required)
    variant   – "cta" (orange, default) | "submit" (gruene Pille)
    chevron   – fuehrendes "›"-Zeichen voranstellen (default: false)
    label     – Linktext; alternativ kann ein Slot befuellt werden
*/

interface Props {
  href:      string;
  variant?:  'cta' | 'submit';
  chevron?:  boolean;
  label?:    string;
}

const {
  href,
  variant  = 'cta',
  chevron,
  label,
} = Astro.props;

// CTA-Buttons erhalten das führende Chevron standardmäßig
const showChevron = chevron ?? (variant === 'cta');
---

<a href={href} class:list={['aw-btn', `aw-btn--${variant}`]}>
  {variant === 'cta'
    ? (
      <span class="aw-btn-inner">
        {showChevron && <span class="aw-btn-chevron" aria-hidden="true">&#x203A;</span>}
        <span class="aw-btn-label">{label ?? <slot />}</span>
      </span>
    )
    : (
      <>
        {showChevron && <span class="aw-btn-chevron" aria-hidden="true">&#x203A;</span>}
        {label ?? <slot />}
      </>
    )
  }
</a>

<style>
  /* ── Basis ── */
  .aw-btn {
    display: inline-block;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1.5;
  }

  /* ── Variante cta (orange) ── */
  .aw-btn--cta {
    background: #EF7F1A;
    color: #fff;
    font-size: 18px;
    padding: 12px 20px;
    border-radius: 5px;
  }

  /* Inhalt-Wrapper: Slide nach rechts beim Hover ── */
  .aw-btn--cta .aw-btn-inner {
    display: inline-flex;
    align-items: center;
  }

  .aw-btn--cta .aw-btn-label {
    display: inline-block;
    transition: transform 0.2s ease-out;
  }

  .aw-btn--cta:hover .aw-btn-label {
    transform: translateX(4px);
  }

  /* ── Variante submit (grüne Pille): kein Slide, nur Hintergrund-Wechsel ── */
  .aw-btn--submit {
    background: #4F7146;
    color: #fff;
    font-size: 18px;
    padding: 12px 28px;
    border-radius: 30px;
    transition: background 0.2s ease-out;
  }

  .aw-btn--submit:hover {
    background: #3D5A36;
  }

  /* ── Chevron-Zeichen ── */
  .aw-btn-chevron {
    margin-right: 5px;
    font-style: normal;
    line-height: 1;
    display: flex;
    align-items: center;
  }
</style>

---
// Marktzeiten: volle Tagesnamen nach Staging-Vorlage.
// » final bestätigen (Markttage noch nicht freigegeben).
const marktzeiten = [
  { tag: 'Dienstag',   ort: 'Emden' },
  { tag: 'Mittwoch',   ort: 'Norderney' },
  { tag: 'Donnerstag', ort: 'Emden-Borssum' },
  { tag: 'Freitag',    ort: 'Emden' },
  { tag: 'Samstag',    ort: 'Emden' },
];
---

<!--
  Bogen: data-URI 1:1 aus customize.css ::before-Regel (Quelle: ../css/customize.css Z. 618-640).
  viewBox 0 0 1920 50, oranges Rechteck #EF7F1A + grüne Ellipse cx=960 cy=50 rx=960 ry=50.
-->
<div aria-hidden="true" class="overflow-hidden leading-none -mb-px">
  <svg
    viewBox="0 0 1920 50"
    preserveAspectRatio="none"
    class="w-full block"
    style="height:50px"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect fill="#EF7F1A" width="1920" height="50"/>
    <ellipse cx="960" cy="50" rx="960" ry="50" fill="#4F7146"/>
  </svg>
</div>

<!-- Grüner Footer (Quelle: computed background-color rgb(79,113,70) = #4F7146) -->
<footer style="background:#4F7146; padding:0; position:relative;">
  <!--
    Container: max-width 85% (computed 1088px bei 1280px VP), padding 65px 40px.
    Das ::before-Pseudo-Element ist 50px hoch (absolut positioniert), daher
    padding-top 65px bereits ausreichend (Bogen liegt über dem Content).
    Quelle: styles.css #footer .inside + computed probe.
  -->
  <div style="max-width:85%; margin:0 auto; padding:65px 40px; position:relative; z-index:2;">
    <!--
      Vier gleich breite Flex-Spalten mit Innenabstand 15px je Seite,
      Row-Container mit neg. margin -15px (Bootstrap-Muster aus pct_theme autogrid_row).
      col border-box = 259.5px, content = 229.5px – exakt wie Staging.
    -->
    <div class="footer-cols" style="display:flex; flex-wrap:wrap; margin:0 -15px; align-items:flex-start; gap:0;">
      <!-- Spalte 0: Signet (229px breit, opacity 0.6 – Quelle: computed probe) -->
      <div style="flex: 1 1 200px; padding:0 15px; box-sizing:border-box;">
        <img
          src="/logo/albert-wilts-signet-invertiert.svg"
          alt=""
          width="320" height="253"
          style="opacity:0.6; width:320px; height:auto; display:block;"
        />
      </div>

      <!--
        Spalte 1: Kontakt
        Spaltentitel: Arimo 400 22.5px weiß (Quelle: computed font-family + font-size + font-weight).
        Fliesstext: Arimo 18px / 27px rgba(255,255,255,0.6) (Quelle: computed).
        Drei distinkte Icons: Telefon (fa-phone), Fax (fa-fax), E-Mail (fa-envelope) als Inline-SVG.
      -->
      <div style="flex: 1 1 200px; padding:0 15px; box-sizing:border-box;">
        <div class="footer-coltitle" style="font-family:Arial, Helvetica, sans-serif; font-weight:400; font-size:22.5px; line-height:1.5; color:#fff; margin-bottom:20px;">
          Kontakt
        </div>
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:18px; line-height:27px; color:rgba(255,255,255,0.6);">
          <p style="margin:0 0 4px;">Albert Wilts e.K.</p>
          <p style="margin:0 0 4px;">Hansestr. 4</p>
          <p style="margin:0 0 12px;">26529 Upgant-Schott</p>
          <!-- Telefon -->
          <p style="margin:0 0 4px; display:flex; align-items:center; gap:8px;">
            <span style="display:inline-block; width:20px; text-align:center; flex-shrink:0;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.57 4.9 2 2 0 0 1 3.55 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
              <a href="tel:+49493491060" style="color:rgba(255,255,255,0.6); text-decoration:none;">+49 4934 91060</a>
          </p>
          <!-- Fax (eigenes Drucker-/Fax-Icon, unterscheidet sich vom Telefon) -->
          <p style="margin:0 0 4px; display:flex; align-items:center; gap:8px;">
            <span style="display:inline-block; width:20px; text-align:center; flex-shrink:0;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 2H8a2 2 0 0 0-2 2v3h12V4a2 2 0 0 0-2-2z"/>
                <line x1="6" y1="13" x2="6.01" y2="13"/>
              </svg>
            </span>
            <a href="tel:+494934910629" style="color:rgba(255,255,255,0.6); text-decoration:none;">+49 4934 910629</a>
          </p>
          <!-- E-Mail -->
          <p style="margin:0; display:flex; align-items:center; gap:8px;">
            <span style="display:inline-block; width:20px; text-align:center; flex-shrink:0;" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </span>
            <a href="mailto:info@albert-wilts.de" style="color:rgba(255,255,255,0.6); text-decoration:none;">info@albert-wilts.de</a>
          </p>
        </div>
      </div>

      <!--
        Spalte 2: Ladenverkauf
        "Wann:" und "Wo:" fett (Quelle: #footer strong font-weight:700 + customize.css).
        Bindestrich im Uhrzeitbereich (kein En-Dash), Inhalt exakt wie Staging.
      -->
      <div style="flex: 1 1 200px; padding:0 15px; box-sizing:border-box;">
        <div class="footer-coltitle" style="font-family:Arial, Helvetica, sans-serif; font-weight:400; font-size:22.5px; line-height:1.5; color:#fff; margin-bottom:20px;">
          Ladenverkauf
        </div>
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:18px; line-height:27px; color:rgba(255,255,255,0.6);">
          <p style="margin:0 0 4px;"><strong style="font-weight:700; color:rgba(255,255,255,0.6);">Wann:</strong></p>
          <p style="margin:0 0 4px;">Jeden Freitag</p>
            <p style="margin:0 0 12px;">08.00 - 18.00 Uhr</p>
          <p style="margin:0 0 4px;"><strong style="font-weight:700; color:rgba(255,255,255,0.6);">Wo:</strong></p>
          <p style="margin:0 0 4px;">Hansestr. 4</p>
          <p style="margin:0;">26529 Upgant-Schott</p>
        </div>
      </div>

      <!--
        Spalte 3: Wochenmarkt
        Tabellen-Werte exakt aus customize.css und computed probe:
        td: padding 0px 12px 8px 0px, border-bottom 1px solid rgba(255,255,255,0.2),
        font-size 18px, color rgba(255,255,255,0.6).
        Erste Zeile pt=0, letzte Zeile kein border-bottom.
      -->
      <div style="flex: 1 1 200px; padding:0 15px; box-sizing:border-box;">
        <div class="footer-coltitle" style="font-family:Arial, Helvetica, sans-serif; font-weight:400; font-size:22.5px; line-height:1.5; color:#fff; margin-bottom:20px;">
          Wochenmarkt
        </div>
        <table class="footer-markttabelle" style="width:100%; border-collapse:collapse; font-size:18px; font-family:Arial, Helvetica, sans-serif;">
          <tbody>
            {marktzeiten.map((m, i) => (
              <tr>
                <td style={[
                  'color:rgba(255,255,255,0.6);',
                  'padding: ' + (i === 0 ? '0' : '8px') + ' 12px 8px 0;',
                  i < marktzeiten.length - 1 ? 'border-bottom:1px solid rgba(255,255,255,0.2);' : '',
                ].join('')}>
                  {m.tag}
                </td>
                <td style={[
                  'color:rgba(255,255,255,0.6);',
                  'padding: ' + (i === 0 ? '0' : '8px') + ' 0 8px 12px;',
                  i < marktzeiten.length - 1 ? 'border-bottom:1px solid rgba(255,255,255,0.2);' : '',
                ].join('')}>
                  {m.ort}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </div>
</footer>

<!--
  Copyright-Band (#bottom).
  Quelle: computed background-color rgb(61,87,54) = #3D5A36 (primary-hover).
  Padding 20px 40px, color rgba(255,255,255,0.4), font-size 16.74px (= 0.93em von 18px).
  Text mit Bindestrich, exakt wie Staging.
-->
<div class="footer-bottom" style="background:#3D5A36; color:rgba(255,255,255,0.4); font-family:Arial, Helvetica, sans-serif; font-size:16.74px; padding:20px 40px;">
  <div class="footer-bottom-inner" style="max-width:85%; margin:0 auto; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:8px;">
    <p style="margin:0;">
      Copyright {new Date().getFullYear()}. Albert Wilts - Idee, Konzept, Umsetzung -
      <a href="https://vonheugel.de" style="color:rgba(255,255,255,0.4); text-decoration:none;">vonheugel.de</a>
    </p>
    <nav aria-label="Rechtliches">
      <ul style="list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:24px;">
        <li><a href="/impressum" style="color:rgba(255,255,255,0.4); text-decoration:none;">Impressum</a></li>
        <li><a href="/datenschutz" style="color:rgba(255,255,255,0.4); text-decoration:none;">Datenschutz</a></li>
        <li><a href="/presse" style="color:rgba(255,255,255,0.4); text-decoration:none;">Presse</a></li>
        <li><a href="#" data-aw-consent-open style="color:rgba(255,255,255,0.4); text-decoration:none; cursor:pointer;">Cookie-Einstellungen</a></li>
      </ul>
    </nav>
  </div>
</div>

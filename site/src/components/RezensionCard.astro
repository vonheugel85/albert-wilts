---
/*
  RezensionCard.astro – eine Google-Bewertung als Karte (Sterne, Text, Name, Monat).
  Wird vom Slider (Rezensionen.astro) und der Seite /bewertungen genutzt.
*/
interface Props {
  text: string;
  name: string;
  rating: number;
  datum: string; // ISO YYYY-MM-DD
}
const { text, name, rating, datum } = Astro.props;
const monat = new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' }).format(new Date(datum));
---

<article class="sub-rez-card">
  <div class="sub-rez-stars" role="img" aria-label={`${rating} von 5 Sternen`}>
    {Array.from({ length: 5 }).map((_, i) => <span class:list={['sub-rez-star', { 'sub-rez-star--leer': i >= rating }]} aria-hidden="true">★</span>)}
  </div>
  <p class="sub-rez-text">{text}</p>
  <p class="sub-rez-meta"><strong>{name}</strong> · Google · {monat}</p>
</article>

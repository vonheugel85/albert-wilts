---
/*
  Nav.astro – vollständige Überarbeitung nach probe-header.mjs (2026-06-19)
  Gemessene Werte (Live-Staging, 1280px VP):
    Header gesamt:      247px (statisch, scrollt weg)
    inside:             max-width 85%, padding 0 40px, margin 0 auto
    Logo-Zeile:         180px breit (auto Höhe ~144px), zentriert, padding ~19px oben/unten
    Nav-Zeile:          Höhe 65px
    L1-Links:           Arimo 13.5px / #696969 / padding 0 22.5px / line-height 65px
    Aktuelle Angebote:  bg #EF7F1A / weiß / padding 0 15px / 16px / radius 4px 4px 0 0
    Dropdown:           bg #fff / box-shadow rgba(0,0,0,0.1) 1px 8px 15px / padding 10px
    DD-Links:           Arimo 13.5px / #555 / padding 8px 22.5px
    Sticky-Klon:        bg #4F7146 / position fixed / opacity-transition 0.3s / z 10000
    Sticky links:       weiß / 70px Höhe
    Mobil-Bar:          bg #1A1418 / 70px / Invertiertes Logo + "Menu"-Burger
*/

interface Props {
  breadcrumbs?: Array<{ label: string; href: string }>;
}

const { breadcrumbs } = Astro.props;
const path = Astro.url.pathname;

function isActive(href: string | null): boolean {
  if (!href) return false;
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
function isItemActive(item: { href: string | null; flyout?: Array<{ href: string }> }): boolean {
  if (isActive(item.href)) return true;
  if (item.flyout) return item.flyout.some((s) => isActive(s.href));
  return false;
}

const navItems = [
  {
    label: 'Für Gewerbekunden', href: '/fuer-gewerbekunden',
    flyout: [
      { label: 'Gastronomie',             href: '/grosshandel-fuer-gastronomie' },
      { label: 'Hotellerie',               href: '/grosshandel-fuer-hotellerie' },
      { label: 'Großverbraucher',          href: '/grosshandel-fuer-grossverbraucher' },
      { label: 'Sortiment und Leistungen', href: '/sortiment-und-leistungen' },
    ],
  },
  {
    label: 'Standorte', href: null,
    flyout: [
      { label: 'Wochenmarkt',  href: '/wochenmarkt' },
      { label: 'Ladenverkauf', href: '/ladenverkauf' },
    ],
  },
  { label: 'Über uns', href: '/ueber-uns' },
  { label: 'Kontakt',  href: '/kontakt' },
];
---

<!-- ══════════════════════════════════════════════════════════════════════
     MOBILES OVERLAY (außerhalb des <header>, Blueprint-Stolperfalle 10)
     ═════════════════════════════════════════════════════════════════════ -->
<div
  id="mobile-overlay"
  aria-hidden="true"
  style="
    position:fixed; inset:0; z-index:100;
    background:#fff;
    display:flex; flex-direction:column;
    opacity:0; pointer-events:none;
    transition:opacity 0.3s;
  "
>
  <!-- Kopfzeile -->
  <div style="
    display:flex; align-items:center; justify-content:space-between;
    padding:0 20px; height:70px;
    border-bottom:1px solid #E5E5E5;
  ">
    <a href="/" aria-label="Albert Wilts – zur Startseite">
      <img
        src="/logo/albert-wilts-logo.png"
        alt="Albert Wilts"
        style="height:44px; width:auto; display:block;"
      />
    </a>
    <button
      id="mobile-close-btn"
      aria-label="Menü schließen"
      style="
        width:44px; height:44px; display:flex; align-items:center; justify-content:center;
        background:none; border:none; cursor:pointer; color:#555;
      "
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           style="width:24px;height:24px;" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Navigation -->
  <nav aria-label="Mobiles Menü" style="overflow-y:auto; flex:1; padding:20px;">
    <ul style="list-style:none; margin:0; padding:0;">
      {navItems.map((item) => (
        <li>
          {item.href ? (
            <a
              href={item.href}
              data-mobile-nav-link
              style={[
                'display:block; padding:12px 0; font-family:Arimo,Arial,sans-serif;',
                'font-size:18px; border-bottom:1px solid #E5E5E5;',
                isItemActive(item) ? 'color:#EF7F1A;' : 'color:#555;',
              ].join('')}
            >{item.label}</a>
          ) : (
            <span
              style={[
                'display:block; padding:12px 0; font-family:Arimo,Arial,sans-serif;',
                'font-size:18px; border-bottom:1px solid #E5E5E5; color:#555;',
              ].join('')}
            >{item.label}</span>
          )}
          {item.flyout && (
            <ul style="list-style:none; margin:0; padding:0 0 0 16px;">
              {item.flyout.map((sub) => (
                <li>
                  <a
                    href={sub.href}
                    data-mobile-nav-link
                    style={[
                      'display:block; padding:8px 0; font-family:Arial,Helvetica,sans-serif;',
                      'font-size:16px; border-bottom:1px solid #E5E5E5;',
                      isActive(sub.href) ? 'color:#EF7F1A;' : 'color:#7F7F7F;',
                    ].join('')}
                  >
                    {sub.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <a
      href="/aktuelle-angebote"
      data-mobile-nav-link
      style="
        display:inline-block; margin-top:24px;
        background:#EF7F1A; color:#fff;
        font-family:Arial,Helvetica,sans-serif; font-size:16px;
        padding:10px 20px; border-radius:5px;
        text-decoration:none;
      "
    >
      Aktuelle Angebote
    </a>
  </nav>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     HAUPT-HEADER (statisch, scrollt weg – Sticky-Klon übernimmt)
     ═════════════════════════════════════════════════════════════════════ -->
<header id="site-header">

  <!-- DESKTOP-LAYOUT: Logo-Zeile + Nav-Zeile (ab 62rem = 992px) -->
  <div class="hd-desktop">
    <div class="hd-inside">

      <!-- Logo-Zeile: zentriert -->
      <!-- Staging: .logo a bg-image = albert-wilts-logo.svg, container 180x180, background-size:100% -->
      <div class="hd-logo-row">
        <a href="/" aria-label="Albert Wilts – zur Startseite">
          <img
            src="/logo/albert-wilts-logo.svg"
            alt="Albert Wilts"
            style="width:180px; height:auto; display:block;"
          />
        </a>
      </div>

      <!-- Nav-Zeile: gesamte Breite, Items links, CTA rechts -->
      <nav id="site-nav" aria-label="Hauptnavigation">
        <ul class="hd-nav-list">

          {navItems.map((item) => (
            <li class={`hd-item${item.flyout ? ' hd-item--dd' : ''}${isItemActive(item) ? ' hd-item--active' : ''}`}>
              {item.href ? (
                <a
                  href={item.href}
                  class={`hd-l1${isItemActive(item) ? ' hd-l1--active' : ''}`}
                  aria-haspopup={item.flyout ? 'true' : undefined}
                  aria-expanded={item.flyout ? 'false' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <button type="button"
                  class={`hd-l1 hd-l1--trigger${isItemActive(item) ? ' hd-l1--active' : ''}`}
                  aria-haspopup="true" aria-expanded="false"
                >
                  {item.label}
                </button>
              )}

              {item.flyout && (
                <ul class="hd-dd" role="menu">
                  {item.flyout.map((sub) => (
                    <li role="none">
                      <a
                        href={sub.href}
                        role="menuitem"
                        class={`hd-dd-link${isActive(sub.href) ? ' hd-dd-link--active' : ''}`}
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}

          <!-- Aktuelle Angebote: CTA, margin-left:auto schiebt ihn nach rechts -->
          <li class="hd-item hd-item--cta">
            <a href="/aktuelle-angebote" class="hd-cta">Aktuelle Angebote</a>
          </li>

        </ul>
      </nav>
    </div>
  </div>

  <!-- MOBIL-BAR: Logo links + Burger rechts (unter 62rem) -->
  <!-- Staging: mobiles Logo = albert-wilts-logo.svg als CSS-BG, 115x70 -->
  <div class="hd-mobile">
    <div class="hd-inside">
      <a href="/" aria-label="Albert Wilts – zur Startseite">
        <img
          src="/logo/albert-wilts-logo.svg"
          alt="Albert Wilts"
          style="height:70px; width:auto; display:block;"
        />
      </a>
      <button
        id="mobile-open-btn"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-overlay"
        style="
          display:flex; align-items:center; gap:6px;
          background:none; border:none; cursor:pointer;
          font-family:Arial,Helvetica,sans-serif; font-size:14px;
          color:#4F7146; font-weight:400;
          padding:0;
        "
      >
        <span>Menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="#4F7146" stroke-width="2"
             style="width:20px;height:20px;" aria-hidden="true">
          <line x1="3" y1="5" x2="21" y2="5"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="19" x2="21" y2="19"/>
        </svg>
      </button>
    </div>
  </div>

</header>

<!-- ══════════════════════════════════════════════════════════════════════
     STICKY-KLON (fixed, grün, blendet beim Scrollen ein)
     Quelle: .stickyheader .header.cloned – bg #4F7146, links weiß, H 140px
     ═════════════════════════════════════════════════════════════════════ -->
<div id="sticky-header" aria-hidden="true">
  <div class="sticky-inner">
    <div class="sticky-inside">

      <!-- Logo-Zeile: links ausgerichtet -->
      <!-- Staging: Sticky-Logo = albert-wilts-wortmarke-invertiert.svg, Container 192x70, bg-size:100% -->
      <div class="sticky-logo-row">
        <a href="/" aria-label="Albert Wilts – zur Startseite">
          <img
            src="/logo/albert-wilts-wortmarke-invertiert.svg"
            alt="Albert Wilts"
            style="width:192px; height:auto; display:block;"
          />
        </a>
      </div>

      <!-- Nav-Zeile: weiße Links -->
      <nav aria-label="Sticky Navigation" tabindex="-1">
        <ul class="sticky-nav-list">

          {navItems.map((item) => (
            <li class={`hd-item${item.flyout ? ' hd-item--dd' : ''}`}>
              {item.href ? (
                <a href={item.href} class="sticky-l1"
                  aria-haspopup={item.flyout ? 'true' : undefined}
                  aria-expanded={item.flyout ? 'false' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <button type="button" class="sticky-l1 hd-l1--trigger"
                  aria-haspopup="true" aria-expanded="false"
                >
                  {item.label}
                </button>
              )}

              {item.flyout && (
                <ul class="hd-dd hd-dd--sticky" role="menu">
                  {item.flyout.map((sub) => (
                    <li role="none">
                      <a href={sub.href} role="menuitem" class="hd-dd-link">{sub.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}

          <li class="hd-item hd-item--cta">
            <a href="/aktuelle-angebote" class="hd-cta sticky-cta">Aktuelle Angebote</a>
          </li>

        </ul>
      </nav>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     STILE (scoped via IDs, keine Tailwind-Utilities nötig für px-Werte)
     ═════════════════════════════════════════════════════════════════════ -->
<style>
  /* ── Haupt-Header ──────────────────────────────────────────────────── */
  #site-header {
    background: #fff;
    position: static; /* scrollt weg; Sticky-Klon übernimmt */
  }

  /* ── Shared inside-Container ──────────────────────────────────────── */
  .hd-inside {
    max-width: 85%;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: content-box;
  }

  /* ── Desktop-Block: default hidden, ab 62rem sichtbar ─────────────── */
  .hd-desktop { display: none; }
  .hd-mobile  { display: block; background: #1A1418; }

  .hd-mobile .hd-inside {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    padding: 0 20px;
    max-width: 100%;
  }

  @media (min-width: 62rem) {
    .hd-desktop { display: block; }
    .hd-mobile  { display: none; }
  }

  /* ── Logo-Zeile ───────────────────────────────────────────────────── */
  .hd-logo-row {
    display: flex;
    justify-content: center;
    align-items: center; /* PNG (144px hoch) vertikal zentrieren wie Staging bg-position:50% */
    height: 180px;       /* Staging: logoDiv.height = 180px, nav startet exakt bei y=180 */
  }

  /* ── Nav-Zeile ────────────────────────────────────────────────────── */
  #site-nav {
    display: block;
    width: 100%;
  }

  .hd-nav-list {
    display: flex;
    align-items: stretch;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Level-1-Items ────────────────────────────────────────────────── */
  .hd-item {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .hd-item--cta {
    /* kein margin-left:auto – CTA sitzt inline direkt hinter Kontakt */
  }

  /* ── Level-1-Links ────────────────────────────────────────────────── */
  .hd-l1 {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px; /* gemessen: span_fontSize 18px auf Staging (Contao setzt 16px am <a>, 18px am inneren <span>) */
    font-weight: 400;
    color: #696969;
    padding: 0 17.5px; /* gemessen: Abstand zw. Items ~35px → 17.5px je Seite */
    line-height: 67px; /* Staging: nav.height = 67px */
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s;
  }

  .hd-l1:hover,
  .hd-l1--active {
    color: #EF7F1A;
  }

  .hd-l1--trigger { appearance: none; -webkit-appearance: none; background: none; border: 0; cursor: pointer; }

  /* ── CTA-Button ───────────────────────────────────────────────────── */
  .hd-cta {
    display: block;
    background: #EF7F1A;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px; /* Staging: span_fontSize 18px, identisch mit hd-l1 */
    font-weight: 400;
    padding: 0 15px;
    line-height: 67px; /* identisch mit hd-l1 */
    border-radius: 4px 4px 0 0;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .hd-cta:hover {
    opacity: 0.85;
  }

  /* ── Dropdowns ────────────────────────────────────────────────────── */
  .hd-dd {
    display: none;
    position: absolute;
    top: 67px; /* Nav-Zeilenhöhe */
    left: 0;
    min-width: 220px;
    background: #fff;
    box-shadow: rgba(0, 0, 0, 0.1) 1px 8px 15px 0px;
    padding: 10px 0;
    list-style: none;
    margin: 0;
    z-index: 200;
  }

  /* Öffnen via CSS: hover + focus-within (tastaturzugänglich) */
  .hd-item--dd:hover > .hd-dd,
  .hd-item--dd:focus-within > .hd-dd {
    display: block;
  }

  .hd-dd-link {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #555;
    padding: 8px 22.5px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.12s, background 0.12s;
  }

  .hd-dd-link:hover,
  .hd-dd-link--active {
    color: #4F7146;
    background: #F8F8F8;
  }

  /* ── Sticky-Header-Klon ───────────────────────────────────────────── */
  #sticky-header {
    display: none; /* nur Desktop */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  #sticky-header.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 62rem) {
    #sticky-header { display: block; }
  }

  .sticky-inner {
    background: #4F7146;
  }

  .sticky-inside {
    max-width: 85%;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: content-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Sticky Logo-Zeile */
  .sticky-logo-row {
    display: flex;
    align-items: center;
    /* Staging: Sticky-Logo-Zeile = 70px (eine Nav-Zeilenhöhe) */
    height: 70px;
  }

  /* Sticky Nav-Liste */
  .sticky-nav-list {
    display: flex;
    align-items: stretch;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Sticky Level-1-Links */
  .sticky-l1 {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px; /* identisch mit hd-l1 */
    font-weight: 400;
    color: #fff;
    padding: 0 17.5px;
    line-height: 70px;
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s;
  }

  .sticky-l1:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Sticky CTA */
  .sticky-cta {
    line-height: 70px;
    border-radius: 4px 4px 0 0;
  }

  /* Sticky-Dropdown – selbe Optik, Offset auf 70px */
  .hd-dd--sticky {
    top: 70px;
  }
</style>

<!-- ══════════════════════════════════════════════════════════════════════
     SCRIPTS
     ═════════════════════════════════════════════════════════════════════ -->

<!-- Mobile Overlay Toggle -->
<script is:inline>
  (function () {
    var overlay  = document.getElementById('mobile-overlay');
    var openBtn  = document.getElementById('mobile-open-btn');
    var closeBtn = document.getElementById('mobile-close-btn');
    if (!overlay || !openBtn || !closeBtn) return;

    function openMenu() {
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
      overlay.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
      overlay.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });

    overlay.querySelectorAll('[data-mobile-nav-link]').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>

<!-- Sticky-Klon: einblenden wenn Original-Header aus dem Viewport gescrollt -->
<script is:inline>
  (function () {
    var sticky = document.getElementById('sticky-header');
    var header = document.getElementById('site-header');
    if (!sticky || !header) return;

    // aria-expanded auf L1-Links mit Flyout per JS pflegen (Tastatur)
    sticky.querySelectorAll('[aria-haspopup="true"]').forEach(function (a) {
      var li = a.parentElement;
      a.addEventListener('focus', function () {
        a.setAttribute('aria-expanded', 'true');
      });
      a.addEventListener('blur', function () {
        // Kurz warten, ob Fokus ins Dropdown geht
        setTimeout(function () {
          if (!li.contains(document.activeElement)) {
            a.setAttribute('aria-expanded', 'false');
          }
        }, 100);
      });
    });

    // Gleiches Muster für Desktop-Nav
    document.querySelectorAll('#site-nav [aria-haspopup="true"]').forEach(function (a) {
      var li = a.parentElement;
      a.addEventListener('focus', function () {
        a.setAttribute('aria-expanded', 'true');
      });
      a.addEventListener('blur', function () {
        setTimeout(function () {
          if (!li.contains(document.activeElement)) {
            a.setAttribute('aria-expanded', 'false');
          }
        }, 100);
      });
    });

    // Sticky einblenden wenn Original aus Viewport
    var threshold = header.offsetHeight || 247;
    var ticking = false;

    function update() {
      if (window.scrollY > threshold) {
        sticky.classList.add('is-visible');
        sticky.setAttribute('aria-hidden', 'false');
      } else {
        sticky.classList.remove('is-visible');
        sticky.setAttribute('aria-hidden', 'true');
      }
      ticking = false;
    }

    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  })();
</script>

---
/*
  HeroSection.astro – Sektion 1 der Startseite.
  Hintergrund kommt von HeroBuehne.astro (Video, Foto, grüner Verlauf), die Sektion selbst ist transparent.
  Inhalt fix, keine Props.
*/
import Button from './Button.astro';
---

<section class="hero-section" aria-label="Hero">

  <!-- Inhalt-Overlay -->
  <div class="hero-inside">
    <div class="hero-content">
      <h1 class="hero-headline">
        Frische verbindet, vom Großverbraucher bis zum Familientisch
      </h1>
      <p class="hero-subline">
        Ob professionelle Küchenlogistik oder der Wocheneinkauf auf dem Markt:
        Albert Wilts liefert Frische aus Tradition. Seit 1958.
      </p>
      <div class="hero-buttons">
        <Button href="/fuer-gewerbekunden" label="Zum Großhandel" />
        <Button href="/wochenmarkt"        label="Markt und Laden" variant="outline" />
      </div>
    </div>
  </div>

</section>

<style>
  /* ── Section: fullwidth, Stacking-Context ── */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 600px;
    background: transparent; /* Hintergrund liefert HeroBuehne.astro */
    display: flex;
    flex-direction: column;
  }




  /* ── Inhalt-Container: über Scrim ── */
  .hero-inside {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 24px;
    box-sizing: border-box;
    width: 100%;
  }

  .hero-content {
    max-width: 660px;
  }

  /* ── Headline: weiss ── */
  .hero-headline {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 400;
    line-height: 52px;
    color: #fff;
    margin-bottom: 20px;
  }

  /* ── Subline: hell-weiss ── */
  .hero-subline {
    font-family: var(--font-sans);
    font-size: 20px; /* Hero-Subline: einzige Lead-Ausnahme (20 statt 18) */
    line-height: 30px;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 36px;
    max-width: 540px;
  }

  /* ── Button-Gruppe: drei nebeneinander, umbrechen wenn nötig ── */
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-section {
      min-height: 420px;
    }


    .hero-inside {
      max-width: 100%;
      padding: 50px 20px;
    }

    .hero-headline {
      font-size: 28px;
}

    .hero-subline {
      font-size: 18px; line-height: 27px;
}

    .hero-buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

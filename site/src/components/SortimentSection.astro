---
/*
  SortimentSection.astro – Sektion 4 der Startseite (article-57 Entsprechung).
  Zwei Spalten: links Bild (bricht bis zum Viewport-Rand aus), rechts Text.
  Keine Props, Inhalt fix.
*/
import Placeholder from './Placeholder.astro';
import Button      from './Button.astro';

const kategorien = [
  {
    titel: 'Regional & Bodenständig',
    text:  'Kartoffeln aus der Leybucht, saisonaler Kohl und knackiges Wurzelgemüse, täglich frisch.',
  },
  {
    titel: 'Exotisch & Bunt',
    text:  'Flugananas, Melonen-Rettich oder Sprossenbrokkoli für die besondere Küche.',
  },
  {
    titel: 'Manufaktur & Ready-Cut',
    text:  'Hausgemachte Geflügelsalate, marinierte Pfannen und sorgfältig geschnittenes Gemüse.',
  },
  {
    titel: 'Herzhaft & Deftig',
    text:  'Fleisch, Wurst und Geflügel in bester Metzger-Qualität, zum Beispiel unser Hähnchen-Gyros.',
  },
  {
    titel: 'Der Ursprung',
    text:  'Frische Eier direkt aus der Region, damit hat bei Albert Wilts alles angefangen.',
  },
];
---

<section class="sortiment-section" aria-label="Unser Frische-Sortiment">
  <div class="sortiment-inside">

    <div class="sortiment-bild">
      <Placeholder label="Sortiment-Bild (Kartoffeln)" aspect="4/3" src="/bilder/unternehmen/gemueselager-kartoffeln-zwiebeln-netzsaecke-paletten.webp" alt="Gemueselager mit Kartoffeln und Zwiebeln in Netzsaecken auf Paletten" />
    </div>

    <div class="sortiment-text">
      <h2>Unser Frische-Sortiment</h2>
      <p class="sortiment-intro">
        Vom Feld direkt zu Ihnen. Egal ob Großgebinde oder Einzelstück,
        wir stehen für Vielfalt. Hier ein kleiner Einblick in unser Sortiment:
      </p>

      <div class="sortiment-kategorien">
        {kategorien.map((kat) => (
          <div class="sortiment-kat">
            <p class="sortiment-kat-titel">{kat.titel}</p>
            <p class="sortiment-kat-text">{kat.text}</p>
          </div>
        ))}
      </div>

      <div class="sortiment-btn">
        <Button href="/sortiment-und-leistungen" label="Komplettes Sortiment entdecken" />
      </div>
    </div>

  </div>
</section>

<style>
  .sortiment-section {
    width: 100%;
    background: #fff;
    padding: 70px 0;
    box-sizing: border-box;
    overflow: hidden;            /* klippt den linken Bild-Ausbruch */
  }

  /*
    Zwei-Spalten-Grid auf 85%-Container: linke Spalte = Bild, rechte = Text.
    align-items: stretch -> beide Zellen bekommen die Zeilenhoehe des Texts.
  */
  .sortiment-inside {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }

  /*
    ── Bild-Zelle ──
    Bild fuellt die halbe Grid-Spalte in voller Zeilenhoehe, bleibt im Container.
  */
  .sortiment-bild {
    position: relative;
  }

  .sortiment-bild :global(.aw-img-wrap) {
    position: absolute;
    inset: 0;
    width: auto !important;
    height: auto !important;
    aspect-ratio: unset !important;
    border-radius: 4px;
  }

  .sortiment-bild :global(.aw-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ── Text-Spalte: Innenabstand links ── */
  .sortiment-text {
    padding: 0 0 0 60px;
    box-sizing: border-box;
  }

  /* ── Intro-Text ── */
  .sortiment-intro {
    font-size: 18px;
    line-height: 1.5;
    color: #555;
    margin-bottom: 28px;
  }

  /* ── Kategorie-Blöcke ── */
  .sortiment-kategorien {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 32px;
  }

  .sortiment-kat-titel {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.3;
    color: #3B3C42;
    margin: 0 0 4px 0;
  }

  .sortiment-kat-text {
    font-size: 18px;
    line-height: 1.5;
    color: #555;
    margin: 0;
  }

  /*
    ── Responsive ──
    Bild wieder normal im Fluss, über dem Text, mit 4/3-Verhältnis.
    Absolut-Positionierung von oben wird hier komplett zurueckgesetzt.
  */
  @media (max-width: 768px) {
    .sortiment-inside {
      max-width: 100%;
      padding: 0 20px;
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .sortiment-bild {
      position: static;
      margin-left: -20px;
      width: calc(100% + 40px);
      order: -1;
    }

    .sortiment-bild :global(.aw-img-wrap) {
      position: static;
      top: auto;
      bottom: auto;
      left: auto;
      right: auto;
      width: 100% !important;
      height: auto !important;
      aspect-ratio: 4/3 !important;
    }

    .sortiment-bild :global(.aw-img) {
      height: 100%;
    }

    .sortiment-text {
      padding: 0;
    }
  }
</style>

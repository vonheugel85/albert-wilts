---
/*
  GeschichteSection.astro – kompakter Teaser auf der Startseite (B6).
  Die ausfuehrliche Timeline bleibt auf /ueber-uns.
*/
import Button      from './Button.astro';
import Placeholder from './Placeholder.astro';
---

<section class="geschichte-section section-pad" aria-label="Unsere Geschichte">
  <div class="geschichte-inside">

    <div class="geschichte-text">
      <h2>Unsere Geschichte</h2>
      <p class="geschichte-sub">Von Moordorf nach ganz Ostfriesland</p>
      <p class="geschichte-lead">
        Hinter Albert Wilts steht keine Investorengruppe, sondern eine Familie.
        Alles begann ganz klein: Der Großvater startete in Moordorf mit dem Verkauf
        von Eiern, direkt vom Bauern zum Kunden.
      </p>
      <Button href="/ueber-uns" label="Mehr über uns" variant="link" />
    </div>

    <div class="geschichte-bild">
      <Placeholder
        label="Betriebsgebäude Albert Wilts"
        aspect="4/3"
        src="/bilder/unternehmen/albert-wilts-gebaeudeaussen-hero.webp"
        alt="Betriebsgebäude von Albert Wilts in Upgant-Schott"
      />
    </div>

  </div>
</section>

<style>
  .geschichte-section {
    width: 100%;
    background: #fff;
    box-sizing: border-box;
  }

  .geschichte-inside {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .geschichte-text h2 { margin-bottom: 6px; }

  .geschichte-sub {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
    color: #4F7146;
    margin: 0 0 20px;
  }

  .geschichte-lead {
    font-size: 18px;
    line-height: 1.6;
    color: #555;
    margin: 0 0 24px;
  }

  @media (max-width: 768px) {
    .geschichte-inside {
      max-width: 100%;
      padding: 0 20px;
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .geschichte-bild { order: -1; }
  }
</style>

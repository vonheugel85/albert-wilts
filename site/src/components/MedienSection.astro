---
/*
  MedienSection.astro – Sektion 6 der Startseite (article-59 Entsprechung).
  bg --color-surface (#F8F8F8). Zwei Spalten: links Text, rechts Video-Stub.
  Keine Props, Inhalt fix.
*/
import Placeholder from './Placeholder.astro';

const medien = [
  'NDR Nordtour: ein Blick hinter die Kulissen unserer Markt-Logistik und des Ladenverkaufs.',
  'Emder Zeitung und Ostfriesen-Zeitung: Berichte über unsere Geschichte und das Jubiläum.',
  'Auszeichnungen: Bio-Zertifizierung und regionale Partnerschaften.',
];
---

<section class="medien-section" aria-label="Albert Wilts in den Medien">
  <div class="medien-inside">

    <div class="medien-text">
      <h2>Albert Wilts in den Medien</h2>
      <p class="medien-intro">
        Wir sind stolz darauf, als ostfriesisches Original wahrgenommen zu werden.
        Vielleicht haben Sie uns schon hier gesehen:
      </p>
      <ul class="medien-liste">
        {medien.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="medien-media">
      <Placeholder label="Video / Facebook-Embed" aspect="16/9" />
    </div>

  </div>
</section>

<style>
  .medien-section {
    width: 100%;
    background: #F8F8F8;
    padding: 70px 0;
    box-sizing: border-box;
  }

  .medien-inside {
    max-width: 85%;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  /* ── Text-Spalte ── */
  .medien-intro {
    font-size: 18px;
    line-height: 1.5;
    color: #555;
    margin-bottom: 24px;
  }

  .medien-liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .medien-liste li {
    font-size: 18px;
    line-height: 1.5;
    color: #555;
    padding-left: 20px;
    position: relative;
  }

  .medien-liste li::before {
    content: '›';
    color: #4F7146;
    font-weight: 700;
    position: absolute;
    left: 0;
    top: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .medien-inside {
      max-width: 100%;
      padding: 0 20px;
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

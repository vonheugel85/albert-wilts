---
/*
  NewsletterSection.astro - Sektion 7. Fullwidth orange.
  Eingabefeld und Button als EIN weisses Pillen-Feld, gruener Button rechts
  eingelassen (wie Staging). Noch keine Anbindung.
*/
---

<section class="nl-section" aria-label="Newsletter">
  <div class="nl-inside">
    <h2 class="nl-headline">Den Einkaufszettel planen?</h2>
    <p class="nl-subline">
      Wissen, was die Woche bringt. Tragen Sie sich ein und erhalten Sie unsere
      aktuellen Angebote bequem per E-Mail.
    </p>
    <form class="nl-form" action="#" method="post" aria-label="Newsletter-Anmeldung">
      <div class="nl-row">
        <label for="nl-email" class="sr-only">E-Mail-Adresse</label>
        <input
          id="nl-email"
          type="email"
          name="email"
          placeholder="E-Mail-Adresse"
          class="nl-input"
          autocomplete="email"
          required
        />
        <button type="submit" class="nl-btn">Anmelden</button>
      </div>
      <p class="nl-hinweis">Kein Spam. Abmeldung jederzeit möglich.</p>
    </form>
  </div>
</section>

<style>
  .nl-section {
    width: 100%;
    background: #EDF1EA;
    padding: 70px 0;
    box-sizing: border-box;
  }
  .nl-inside {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
    text-align: center;
  }
  .nl-headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 37.5px;
    line-height: 1.2;
    color: #3B3C42;
    margin-bottom: 16px;
  }
  .nl-subline {
    font-size: 18px;
    line-height: 1.5;
    color: #555;
    margin-bottom: 32px;
  }
  /* Input + Button in EINEM weissen Pillen-Feld */
  .nl-row {
    display: flex;
    align-items: center;
    max-width: 460px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid #CFD8CB;
    border-radius: 28px;
    padding: 5px 6px 5px 10px;
    box-sizing: border-box;
  }
  .nl-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    font-family: var(--font-sans);
    font-size: 18px;
    color: #3B3C42;
    background: transparent;
    border: none;
  }
  .nl-input::placeholder { color: #8a8a8a; }
  .nl-input:focus { outline: none; }
  /* gruener Button rechts eingelassen */
  .nl-btn {
    flex-shrink: 0;
    height: 44px;
    padding: 0 28px;
    background: #EF7F1A;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 18px;
    border: none;
    border-radius: 22px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease-out;
  }
  .nl-btn:hover { background: #d9700f; }
  .nl-hinweis {
    font-size: 13px;
    color: #777;
    margin-top: 14px;
  }
  @media (max-width: 480px) {
    .nl-inside { padding: 0 20px; }
    .nl-row { max-width: 100%; }
  }
</style>
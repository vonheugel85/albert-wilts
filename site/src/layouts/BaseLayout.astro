---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Quicklinks from '../components/Quicklinks.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Array<{ label: string; href: string }>;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean; // true: Seite traegt robots noindex, nofollow (Testseiten, K5b 2026-10-16)
}

const {
  title,
  description = 'Albert Wilts e.K., Lebensmittel-Großhandel seit 1958 in Upgant-Schott. Frische aus Tradition.',
  breadcrumbs,
  ogImage,
  ogImageAlt = '',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

// Kanonische URL aus aktuellem Pfad + Site-Basis
const siteBase = Astro.site ?? new URL('https://albert-wilts.de');
const canonical = new URL(Astro.url.pathname, siteBase).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteBase).href : undefined;

// Statisches Organization-JSON-LD (gilt für jede Seite)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteBase}#organization`,
  name: 'Albert Wilts e.K.',
  url: siteBase.href,
  logo: `${siteBase}logo/albert-wilts-logo.png`, // vorher /logo.png, die Datei gab es nie (L1, 23.10.2026)
  foundingDate: '1958',
  areaServed: 'Ostfriesland',
  telephone: '+49 4934 91060',
  email: 'info@albert-wilts.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Hansestraße 4',
    postalCode: '26529',
    addressLocality: 'Upgant-Schott',
    addressCountry: 'DE',
  },
};

// Optionales seitenspezifisches JSON-LD (z. B. BreadcrumbList, FAQPage)
const extraJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon + Theme-Color -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/caladea-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#4F7146" />

    <!-- Font Awesome 4.7 (Quicklinks-Icons) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      integrity="sha512-SfTiTlX6kk+qitfevl/7LibUOeJWlt9rbyDn92a1DqWOw9vWG2MFoays0sgObmWazO5BQPiFucnnEAjpAB+/Sw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Albert Wilts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Organization-JSON-LD (statisch, jede Seite) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <!-- Seitenspezifisches JSON-LD (BreadcrumbList, FAQPage usw.) -->
    {extraJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <!-- Skip-Link für Tastatur-Navigation und Screenreader -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2
             focus:z-[200] focus:bg-primary focus:text-white focus:px-4
             focus:py-2 focus:rounded focus:font-sans focus:text-sm"
    >
      Zum Hauptinhalt springen
    </a>

    <Nav breadcrumbs={breadcrumbs} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <Quicklinks />
    <ConsentBanner />
    <Lightbox />
    <script>
      /* Hintergrundvideos (Startseite, Box): Autoplay explizit anstossen, Safari startet muted-Videos sonst nicht
         zuverlaessig. Bei "Bewegung reduzieren" bleibt das Poster stehen. (V3, 2026-10-23) */
      const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
      for (const v of document.querySelectorAll<HTMLVideoElement>('video[autoplay][muted]')) {
        if (reduziert) { v.removeAttribute('autoplay'); v.pause(); continue; }
        v.muted = true;
        const start = () => v.play().catch(() => {});
        if (v.readyState >= 2) start(); else v.addEventListener('loadeddata', start, { once: true });
      }
    </script>
    <script>
      /* Messung der Ziele in GA4 (F12, 28.10.2026). gtag existiert nur, wenn der Besucher
         der Statistik zugestimmt hat; ohne Einwilligung passiert hier nichts. Die Namen
         entsprechen den Schluesselereignissen in der Property "albert-wilts.de". */
      (window as any).awEvent = (name: string, params: Record<string, unknown> = {}) => {
        const g = (window as any).gtag;
        if (typeof g === 'function') g('event', name, params);
      };

      /* Telefon und E-Mail sind bei einem Grosshandel die wichtigsten Wege, wichtiger als
         jedes Formular. Ein Listener am Dokument faengt alle Links, auch die in der
         Quicklink-Leiste und im Footer. */
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement)?.closest?.('a[href^="tel:"], a[href^="mailto:"]');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        (window as any).awEvent(
          href.startsWith('tel:') ? 'telefon_klick' : 'email_klick',
          { ziel: href.replace(/^(tel|mailto):/, ''), seite: location.pathname }
        );
      });
    </script>

    <script>
      /* Zeitfalle gegen Formularspam (F9, 2026-10-27): beim Laden den Zeitpunkt in ein verstecktes Feld
         schreiben, server.mjs verwirft Einsendungen, die zu schnell kommen oder gar keinen Zeitstempel
         haben. Ohne JavaScript fehlt das Feld, das allein reicht dort aber nicht fuer eine Ablehnung. */
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-formular], form[data-cl-form]')) {
        const feld = document.createElement('input');
        feld.type = 'hidden';
        feld.name = '_ts';
        feld.value = String(Date.now());
        form.appendChild(feld);
      }
    </script>

    <script>
      /* Kontakt- und Newsletter-Formular (data-formular): per fetch an /api/formular senden, Antwort inline zeigen.
         Ohne JavaScript schickt der Browser das Formular normal ab und bekommt eine Bestaetigungsseite. (F3, 2026-10-23) */
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-formular]')) {
        const status = form.querySelector<HTMLElement>('[data-formular-status]');
        const knopf = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.reportValidity()) return;
          if (knopf) knopf.disabled = true;
          const zeige = (ok: boolean, text: string) => { if (!status) return; status.textContent = text; status.hidden = false; status.classList.toggle('sub-form-status--ok', ok); status.classList.toggle('sub-form-status--fehler', !ok); };
          try {
            const r = await fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form) as any), headers: { Accept: 'application/json' } });
            const j = await r.json().catch(() => ({}));
            if (!r.ok || !j.ok) throw new Error(j.text || 'Das Senden hat nicht geklappt. Rufen Sie uns an unter 04934 91060 oder schreiben Sie an info@albert-wilts.de.');
            zeige(true, j.text);
            // Welches Formular, steht im versteckten Feld "formular"
            const art = (new FormData(form).get('formular') || 'unbekannt').toString();
            (window as any).awEvent(
              art === 'newsletter' ? 'newsletter_anmeldung' : 'kontaktformular',
              { formular: art, seite: location.pathname }
            );
            form.reset();
            for (const el of form.querySelectorAll<HTMLElement>('input:not([type=hidden]), select, textarea, button')) (el as HTMLInputElement).disabled = true;
          } catch (err) {
            zeige(false, (err as Error).message);
            if (knopf) knopf.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
